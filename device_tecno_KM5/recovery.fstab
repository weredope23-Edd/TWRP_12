# TWRP fstab for TECNO KM5 (MT6768), derived from the stock recovery.fstab.
# <mount point>   <fstype>   <device>   [device2]   <flags>

# --- Core ---------------------------------------------------------------
/metadata         f2fs   /dev/block/by-name/metadata     flags=display="Metadata"
/data             f2fs   /dev/block/by-name/userdata     flags=fileencryption=aes-256-xts:aes-256-cts:v2;keydirectory=/metadata/vold/metadata_encryption
/misc             emmc   /dev/block/by-name/misc         flags=display="Misc"

# --- Dynamic partitions (inside super) ----------------------------------
/system_root      erofs  system                          flags=display="System";logical;slotselect
/system_ext       erofs  system_ext                      flags=display="System_ext";logical;slotselect
/vendor           erofs  vendor                          flags=display="Vendor";logical;slotselect
/product          erofs  product                         flags=display="Product";logical;slotselect
/vendor_dlkm      erofs  vendor_dlkm                     flags=display="Vendor_dlkm";logical;slotselect
/odm_dlkm         erofs  odm_dlkm                        flags=display="Odm_dlkm";logical;slotselect
/system_dlkm      erofs  system_dlkm                     flags=display="System_dlkm";logical;slotselect
/super            emmc   /dev/block/by-name/super        flags=display="Super";backup=1;flashimg=1

# --- A/B boot-chain images ----------------------------------------------
/boot             emmc   /dev/block/by-name/boot         flags=display="Boot";slotselect;backup=1;flashimg=1
/init_boot        emmc   /dev/block/by-name/init_boot    flags=display="Init_boot";slotselect;backup=1;flashimg=1
/vendor_boot      emmc   /dev/block/by-name/vendor_boot  flags=display="Vendor_boot";slotselect;backup=1;flashimg=1
/dtbo             emmc   /dev/block/by-name/dtbo         flags=display="Dtbo";slotselect;backup=1;flashimg=1
/vbmeta           emmc   /dev/block/by-name/vbmeta       flags=display="Vbmeta";slotselect;flashimg=1
/vbmeta_system    emmc   /dev/block/by-name/vbmeta_system flags=display="Vbmeta_system";slotselect;flashimg=1
/vbmeta_vendor    emmc   /dev/block/by-name/vbmeta_vendor flags=display="Vbmeta_vendor";slotselect;flashimg=1

# --- Slotted MediaTek firmware (layout: *_a / *_b) -----------------------
/lk               emmc   /dev/block/by-name/lk           flags=display="LK";slotselect;flashimg=1
/logo             emmc   /dev/block/by-name/logo         flags=display="Logo";slotselect;flashimg=1
/tee              emmc   /dev/block/by-name/tee          flags=display="TEE";slotselect;flashimg=1
/scp              emmc   /dev/block/by-name/scp          flags=display="SCP";slotselect;flashimg=1
/sspm             emmc   /dev/block/by-name/sspm         flags=display="SSPM";slotselect;flashimg=1
/gz               emmc   /dev/block/by-name/gz           flags=display="GenieZone";slotselect;flashimg=1
/spmfw            emmc   /dev/block/by-name/spmfw        flags=display="SPMFW";slotselect;flashimg=1
/modem            emmc   /dev/block/by-name/modem        flags=display="Modem";slotselect;flashimg=1
/tkv              emmc   /dev/block/by-name/tkv          flags=display="TKV";slotselect;flashimg=1

# --- MediaTek calibration / identity (IMEI, Wi-Fi/BT MAC) ---------------
/nvram            emmc   /dev/block/by-name/nvram        flags=display="NVRAM";backup=1;flashimg=1
/nvdata           ext4   /dev/block/by-name/nvdata       flags=display="NVData";backup=1
/nvcfg            ext4   /dev/block/by-name/nvcfg        flags=display="NVCfg";backup=1
/proinfo          emmc   /dev/block/by-name/proinfo      flags=display="Proinfo";backup=1;flashimg=1
/protect_f        ext4   /dev/block/by-name/protect1     flags=display="Protect_f";backup=1
/protect_s        ext4   /dev/block/by-name/protect2     flags=display="Protect_s";backup=1
/persist          ext4   /dev/block/by-name/persist      flags=display="Persist";backup=1

# --- Removable storage --------------------------------------------------
/external_sd      auto   /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=display="MicroSD";storage;wipeingui;removable
/usb_otg          auto   /dev/block/sda1 /dev/block/sda          flags=display="USB-OTG";storage;wipeingui;removable
