# Derived from the stock init.recovery.mt6768.rc.
# Only the USB gadget setup is kept: the stock preloader symlinks and
# mtk_plpath_utils call are only needed when flashing the preloader and the
# symlinks assume UFS, while this board's userdata sits on eMMC (11230000.mmc).

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

on fs
    # USB should connect regardless of CDP/SDP detection
    write /sys/class/udc/musb-hdrc/device/cmode 2

# Trustonic (mobicore) keeps its registry under /mnt/vendor/persist/mcRegistry.
on post-fs
    mkdir /mnt/vendor 0755 system system
    mkdir /mnt/vendor/persist 0771 system system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist nosuid nodev noatime
